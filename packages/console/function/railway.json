{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "installCommand": "bun install",
    "buildCommand": "bun run build"
  },
  "deploy": {
    "startCommand": "bun run dev:console",
    "sleepApplication": false,
    "restartPolicyType": "ON_FAILURE"
  }
}
